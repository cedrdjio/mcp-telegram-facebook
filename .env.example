# ============================================================
#  Configuration du serveur MCP Telegram → Facebook
#  Copiez ce fichier en `.env` et remplissez les valeurs.
# ============================================================

# ---------- Telegram (API MTProto, compte utilisateur) ----------
# Obtenez API_ID et API_HASH sur https://my.telegram.org  ->  "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session persistante générée par `npm run telegram:login`.
# Elle évite de se reconnecter (code SMS) à chaque démarrage.
TELEGRAM_SESSION=

# ---------- Facebook (Graph API — gestion de Page) ----------
# Jeton d'accès de Page (Page Access Token) ou d'utilisateur, avec les permissions :
#   pages_show_list, pages_manage_posts, pages_read_engagement, read_insights
# Générez-le via https://developers.facebook.com/tools/explorer
# (Les publicités sont gérées séparément par le MCP Facebook Ads officiel.)
FACEBOOK_ACCESS_TOKEN=

# ID de la Page Facebook par défaut sur laquelle publier (optionnel).
FACEBOOK_PAGE_ID=

# Version de l'API Graph (par défaut v21.0)
FACEBOOK_GRAPH_VERSION=v21.0

# ---------- Mode HTTP / web (Railway, Claude.ai) ----------
# Jeton secret exigé pour appeler le serveur en HTTP. INDISPENSABLE si le serveur
# est exposé sur Internet : sans lui, n'importe qui pourrait utiliser vos comptes.
# Générez une valeur aléatoire, ex : openssl rand -hex 32
MCP_AUTH_TOKEN=

# Identifiants OAuth (flux "Authorization Code" + PKCE) exigés par le
# connecteur personnalisé de Claude.ai, qui n'accepte que l'OAuth (ni en-tête
# personnalisé, ni paramètre d'URL). Générez deux valeurs aléatoires, ex :
#   openssl rand -hex 16   -> MCP_OAUTH_CLIENT_ID
#   openssl rand -hex 32   -> MCP_OAUTH_CLIENT_SECRET
# À coller dans Claude.ai : Paramètres avancés > ID client OAuth / Secret client OAuth.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# Port d'écoute HTTP. Sur Railway, la variable PORT est fournie automatiquement.
PORT=3000

# ---------- Divers ----------
# Répertoire de téléchargement temporaire des vidéos.
DOWNLOAD_DIR=./downloads
