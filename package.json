{
  "name": "mcp-telegram-facebook",
  "version": "0.4.0",
  "description": "Serveur MCP universel Telegram–Facebook pour ChatGPT : 31 outils, Streamable HTTP, OAuth 2.1/PKCE, annotations, schémas de sortie et moteur Graph API.",
  "type": "module",
  "bin": {
    "mcp-telegram-facebook": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "telegram:login": "node dist/scripts/telegram-login.js",
    "clean": "rm -rf dist",
    "postinstall": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "telegram",
    "facebook",
    "ads",
    "marketing-api"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.4.5",
    "telegram": "^2.22.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
